# Copy to .env (or run scripts/init-env.sh, which fills every __TOKEN__ with a random secret).
# .env is git-ignored and excluded from Docker build contexts. Never commit it.

# --- network exposure -------------------------------------------------------------------
# 127.0.0.1 = reachable only from the VM itself (use an SSH tunnel). 0.0.0.0 publishes every
# port on all interfaces; Docker bypasses UFW for published ports, so use a cloud firewall.
BIND_ADDRESS=127.0.0.1

# --- source database (Postgres 18) ------------------------------------------------------
POSTGRES_USER=banking
POSTGRES_PASSWORD=password
POSTGRES_DB=banking

# --- Kafka (KRaft) ----------------------------------------------------------------------
KAFKA_CLUSTER_ID=ID_1
KAFKA_RETENTION_HOURS=48


KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=admin

# --- object store (RustFS, S3 API). The access key must be UPPERCASE letters/digits only ---
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin
S3_BUCKET=banking-cdc

# --- Airflow ----------------------------------------------------------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow
AIRFLOW_FERNET_KEY=airflowkey
AIRFLOW_JWT_SECRET=airflowsecretasdfghjklsdfghjkl
AIRFLOW_API_SECRET_KEY=airflowsecretasdfghjklsdfghjkl
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=airflowsecretasdfghjklsdfghjkl

# Each ingest run that finds new files wakes the Snowflake warehouse (costs credits).
INGEST_SCHEDULE=*/15 * * * *
DBT_SCHEDULE=@daily

# --- Snowflake (SaaS: the one thing that cannot run in Docker) --------------------------
# ACCOUNT is the account identifier, e.g. xy12345.eu-west-1 (no https://, no .snowflakecomputing.com)


SNOWFLAKE_ACCOUNT=WJYAGEO-JC88970
SNOWFLAKE_USER=BANKING_SVC
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_PATH=/run/secrets/snowflake/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=BANKING_ROLE

# Auth, choose one. Key-pair is recommended: Snowflake is enforcing MFA / blocking
# single-factor passwords. Put the PKCS#8 private key in ./secrets/ and point at it as
# seen INSIDE the container, e.g. /run/secrets/snowflake/rsa_key.p8

# Optional; leave empty to use the user's default role. Needs CREATE DATABASE/WAREHOUSE for the bootstrap.

SNOWFLAKE_WAREHOUSE=BANKING_WH
SNOWFLAKE_DB=BANKING
SNOWFLAKE_SCHEMA=RAW

# --- data generator ---------------------------------------------------------------------
# Each iteration inserts customers + accounts + transactions; the loop runs forever.

GEN_NUM_CUSTOMERS=10
GEN_ACCOUNTS_PER_CUSTOMER=2
GEN_NUM_TRANSACTIONS=50
GEN_SLEEP_SECONDS=30

# --- consumer -----------------------------------------------------------------------------
CONSUMER_BATCH_SIZE=50
CONSUMER_FLUSH_SECONDS=10
